using System;

namespace ConsoleApp1
{
    internal class Program
    {
        static void Main(string[] args)
        {
            Console.Write("Ingrese un numero: ");
            int n = Convert.ToInt16(Console.ReadLine());
            int suma = 0;
            int i = 1;
            while (i <= n)
            {
                suma = suma + i;
                i = i+1;
            }
            Console.WriteLine($"La suma es: {suma}");
        }
    }
}
