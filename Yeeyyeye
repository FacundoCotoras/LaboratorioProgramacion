using System;

namespace ConsoleApp2
{
    internal class Program
    {
        static void Main(string[] args)
        {
            // [cliente, dato]
            // 0 = depósitos, 1 = extracciones, 2 = comisiones, 3 = intereses, 4 = saldo
            double[,] clientes = new double[101, 5]; // 1 a 100

            int opcion = -1;
            while (opcion != 4)
            {
                Console.Write("Ingrese el N° de Cliente (1-100): ");
                int cliente = int.Parse(Console.ReadLine());

                Console.WriteLine("\n-------OPERACIONES--------");
                Console.WriteLine("0. Depositar");
                Console.WriteLine("1. Extracción");
                Console.WriteLine("2. Comisiones Deducidas");
                Console.WriteLine("3. Intereses Acreditados");
                Console.WriteLine("4. Salir");
                Console.Write("Seleccione opción: ");
                opcion = int.Parse(Console.ReadLine());

                switch (opcion)
                {
                    case 0:
                        Console.Write("Monto a depositar: ");
                        double dep = double.Parse(Console.ReadLine());
                        clientes[cliente, 0] += dep;
                        clientes[cliente, 4] += dep;
                        break;

                    case 1:
                        Console.Write("Monto a extraer: ");
                        double ext = double.Parse(Console.ReadLine());
                        clientes[cliente, 1] += ext;
                        clientes[cliente, 4] -= ext;
                        break;

                    case 2:
                        Console.Write("Monto de comisiones: ");
                        double com = double.Parse(Console.ReadLine());
                        clientes[cliente, 2] += com;
                        clientes[cliente, 4] -= com;
                        break;

                    case 3:
                        Console.Write("Monto de intereses: ");
                        double inte = double.Parse(Console.ReadLine());
                        clientes[cliente, 3] += inte;
                        clientes[cliente, 4] += inte;
                        break;

                    case 4:
                        Console.WriteLine("Saliendo...");
                        break;

                    default:
                        Console.WriteLine("Opción inválida.");
                        break;
                }
            }

            // Mostrar resumen
            Console.WriteLine("\n===== RESUMEN DE CLIENTES =====");
            double maxDeposito = 0;
            for (int i = 1; i <= 100; i++)
            {
                if (clientes[i, 0] > 0 || clientes[i, 1] > 0 || clientes[i, 2] > 0 || clientes[i, 3] > 0)
                {
                    Console.WriteLine($"Cliente {i} | Depósitos: {clientes[i,0]} | Extracciones: {clientes[i,1]} | Comisiones: {clientes[i,2]} | Intereses: {clientes[i,3]} | Saldo: {clientes[i,4]}");
                }

                if (clientes[i, 0] > maxDeposito)
                {
                    maxDeposito = clientes[i, 0];
                }
            }

            Console.WriteLine($"\nMáximo depósito realizado: {maxDeposito}");
            Console.WriteLine("Clientes con ese depósito:");
            for (int i = 1; i <= 100; i++)
            {
                if (clientes[i, 0] == maxDeposito)
                {
                    Console.WriteLine($"Cliente {i}");
                }
            }
        }
    }
}
