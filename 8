namespace ConsoleApp1
{
        internal class Program
    {
        static void Main(string[] args)
        {
            double[,] numeros = new double[4, 7];
            double[] total = new double[4];
            double sum = 0;
            int th = 0;
            double mayor = double.MinValue;

            for (int i = 0; i < numeros.GetLength(0); i++)
            {
                sum = 0;
                Console.WriteLine("Semana "+(i+1));
                for (int j = 0; j < numeros.GetLength(1); j++)
                {

                    Console.WriteLine("Ingresos del Dia "+(j+1)+": ");
                    numeros[i, j] = double.Parse(Console.ReadLine());
                    sum += numeros[i, j];
                    total[i] += numeros[i, j];
                }
                if(sum > mayor)
                {
                    mayor = sum;
                    th = i;

                }
            }

 
            
            
            
            
            
            
            
            
            for(int i = 0; i < numeros.GetLength(0); i++)
            {
                Console.WriteLine("Lo Recaudado en la Semana " + (i + 1) + "es: $" + (total[i]));
                Console.WriteLine("El Promedio de Ventas en la Semana " + (i + 1) + " es: $" + (total[i] / 7));

            }
            Console.WriteLine("La Semana que Mas Recaudo fue la " +(th+1) +" con una Recaudacion de $"+ (mayor));

        }
    }
}
