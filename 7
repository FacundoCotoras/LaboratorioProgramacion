namespace ConsoleApp1
{
    internal class Program
    {
        static void Main(string[] args)
        {
            int[,] numeros = new int[3, 5];
            int menor = int.MaxValue;
            int suma = 0;
            int c = 0;

            for(int i = 0; i< 3; i++)
            {
                for(int j = 0; j < 5; j++)
                {
                    Console.WriteLine($"Ingrese el Numero de la posicion {i+1}, {j+1}: ");
                    numeros[i, j] = int.Parse(Console.ReadLine());
                }
            }

            for (int i = 0; i < 3; i++)
            {
                for (int j = 0; j < 5; j++)
                {
                    if (numeros[i, j] < menor)
                        menor = numeros[i, j];
                }
            }

            for (int i = 0; i < 3; i++)
            {
                for (int j = 0; j < 5; j++)
                {
                    if (i < 2)
                        suma += numeros[i, j];

                }
            }

            for (int i = 0; i < 3; i++)
            {
                for (int j = 0; j < 5; j++)
                {
                    if(j >= 1 && j < 4)
                    {
                        if (numeros[i, j] < 0)
                            c++;
                    }
                        
                }
            }
            Console.WriteLine("---------------------------------------------------------------------------------------");


            for (int i = 0; i < 3; i++)
            {
                for (int j = 0; j < 5; j++)
                {
                    Console.Write( numeros[i, j] + "\t");
                }
                Console.WriteLine();
            }
            Console.WriteLine("---------------------------------------------------------------------------------------");
            Console.WriteLine($"El Numero Mas Chico es {menor}.");
            Console.WriteLine($"La Suma de los Elementos de las 2 Primeras Filas del Arreglo es: {suma}.");
            Console.WriteLine($"Total de Elementos Negativos en las Columnas de la Segunda a la Cuarta: {c}");
        }
    }
}
