using System;

class Program
{
    static void Main()
    {
        double[] Notas = new double[15];

        for (int i = 0; i < 15; i++)
        {
            Console.Write($"Ingrese la nota del alumno {i + 1}: ");
            Notas[i] = Convert.ToDouble(Console.ReadLine());
        }

        Console.WriteLine("Los alumnos con nota mayor a 8 son:");

        for (int i = 0; i < 15; i++)
        {
            if (Notas[i] > 8)
            {
                Console.WriteLine($"Alumno {i + 1}");
            }
        }
    }
}
