using System.ComponentModel.Design;

namespace Ejercicio
{
    internal class Program
    {
        static void Main(string[] args)
        {
            int[] numeros = new int[15];
            int mayor = -9999999;
            double suma = 0;
            for (int i = 0; i < 15; i++) 
            {
                Console.WriteLine($"Ingrese el Valor {i+1}: ");
                numeros[i] = Convert.ToInt16(Console.ReadLine());
                suma = suma + numeros[i];
                if (numeros[i] > mayor)
                    mayor = numeros[i];
            }
             
             Console.WriteLine($"El mayor valor es: {mayor}");
            Console.WriteLine($"El promedio es {suma / 15}");
        }
    }
}
