
namespace Ejercicio
{
    internal class Program
    {
        static void Main(string[] args)
        {
            int neg = 0;
            int pos = 0;
            int ig = 0;
            for(int i = 0; i < 10; i++)
            {
                Console.Write($"Ingrese el numero {i + 1}: ");
                int numero = Convert.ToInt32(Console.ReadLine());
                if(numero < 0)
                {
                    neg++;
                }else if(numero == 0)
                {
                    ig++;
                }
                else
                {
                    pos++;
                }
            }
            Console.WriteLine($"Hay {neg} numeros negativos, {ig} numeros iguales a 0 y {pos} numeros positivos.");
        }
    }
}
