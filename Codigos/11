using System.ComponentModel.Design;

namespace Ejercicio
{
    internal class Program
    {
        static void Main(string[] args)
        {
            string[] Pais = new string[3];
            int[] Pop = new int[3];
            double[] Sup = new double[3];
            double[] Den = new double[3];
            double max = 0;
            int x = 0;
            for (int i = 0; i < 3; i++)
            {
                Console.WriteLine("Ingrese el país");
                Pais[i] = Console.ReadLine();
                Console.WriteLine("Ingrese la poblacion");
                Pop[i] = Convert.ToInt32(Console.ReadLine());
                 Console.WriteLine("Ingrese la superficie en kilometros");
                Sup[i] = Convert.ToDouble(Console.ReadLine());
                Den[i] = Pop[i] / Sup[i];
                if (max < Den[i])
                    max = Den[i];
                    x = i;
            }
            Console.WriteLine($"El pais {Pais[x]} es el mas densamente poblado con una densidad de {Den[x]} hab/km²");
        }
    }
}


