using System.ComponentModel.Design;

namespace Ejercicio
{
    internal class Program
    {
        static void Main(string[] args)
        {
            double p = 0;
            Console.Write("Ingrese una cantidad de horas: ");
            int hora = Convert.ToInt32(Console.ReadLine());
            Console.Write("Ingrese una cantidad de minutos: ");
            int minuto = Convert.ToInt32(Console.ReadLine());
            Console.Write("Ingrese una cantidad de segundos: ");
            int segundo = Convert.ToInt32(Console.ReadLine());
            Console.Write("Ingrese un numero entre 1 y 3(1-segundos, 2-minutos, 3-horas): ");
            int x = Convert.ToInt32(Console.ReadLine());

            if (x == 1)
            {
                segundo = hora * 3600 + minuto * 60 + segundo;
                Console.WriteLine($"Los valores pasados a segundos serian: {segundo} segundos");
            }
            else if (x == 2)
            {
                p = hora * 60 + minuto + segundo / 60;
                Console.WriteLine($"Los valores pasados a minutos serian: {p} minutos");
            }
            else
            {
                p = hora + minuto / 60 + segundo / 3600;
                Console.WriteLine($"Los valores pasados a horas serian: {p} horas");
            }

        }
    }
}
