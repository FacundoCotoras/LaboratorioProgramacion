namespace ConsoleApp1
{
    internal class Program
    {
        static void Main(string[] args)
        {
            int[] Num = new int[6];
            for(int i = 0; i < 6; i++)
            {
                Console.WriteLine("Ingrese un numero: ");
                Num[i] = int.Parse(Console.ReadLine());
            }
            Console.WriteLine("-----------------------------------");
            for(int i = 0; i < 6; i+=2)
            {

                Console.WriteLine(Num[i+1]);
                
            }
        }
    }
}
