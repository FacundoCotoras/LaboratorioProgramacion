namespace ConsoleApp1
{
    internal class Program
    {
        static void Main(string[] args)
        {
            double sum = 0;
            string aux1 = "";
            double aux = 0;
            string[] nombres = new string[10];
            double[] tiempo = new double[10];
            for(int i = 0; i < tiempo.Length; i++)
            {
                Console.WriteLine("---------------------------------------------");
                Console.WriteLine("Ingrese el Nombre del Corredor " + (i + 1));
                nombres[i] = Console.ReadLine();
                Console.WriteLine("Ingrese el tiempo del Corredor "+(i+1));
                tiempo[i] = double.Parse(Console.ReadLine());
                sum += tiempo[i];
            }
            for(int i = 0; i < tiempo.Length-1; i++)
            {
                for(int j = i+1; j < tiempo.Length; j++)
                {
                    if (tiempo[i] > tiempo[j])
                    {
                        aux = tiempo[i];
                        tiempo[i] = tiempo[j];
                        tiempo[j] = aux;
                        aux1 = nombres[i];
                        nombres[i] = nombres[j];
                        nombres[j] = aux1;
                    }

                }
            }
            for (int i = 0; i < tiempo.Length; i++)
            {
                Console.WriteLine(tiempo[i]);

            }
            Console.WriteLine("1er Puesto: " + nombres[0]);
            Console.WriteLine("2do Puesto: " + nombres[1]);
            Console.WriteLine("Ultimo Puesto: " + nombres[9]);
            Console.WriteLine("Tiempo Promedio: "+ (sum/tiempo.Length));
        }
    }
}
