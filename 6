namespace ConsoleApp1
{
    internal class Program
    {
        static void Main(string[] args)
        {
            int[,] numeros = new int[3, 5];

            for(int i = 0; i< 3; i++)
            {
                for(int j = 0; j < 5; j++)
                {
                    Console.WriteLine($"Ingrese el Numero de la posicion {i+1}, {j+1}: ");
                    numeros[i, j] = int.Parse(Console.ReadLine());
                }
            }


            for (int i = 0; i < 3; i++)
            {
                for (int j = 0; j < 5; j++)
                {
                    if (numeros[i, j] < 0)
                        numeros[i, j] = 0;
                }
            }

            for (int i = 0; i < 3; i++)
            {
                for (int j = 0; j < 5; j++)
                {
                    Console.Write( numeros[i, j] + "\t");
                }
                Console.WriteLine();
            }
        }
    }
}
