using System;

namespace ConsoleApp2
{
    internal class Program
    {
        struct Productos
        {
            public int codigo;
            public string nombre;
            public double precio;
        }

        static void Main(string[] args)
        {
            Productos[] producto = new Productos[10];

            for(int i= 0; i<10; i++)
            {
                Console.Write($"Ingrese el codigo del producto {i +1}: ");
                producto[i].codigo = int.Parse(Console.ReadLine());
                Console.Write($"Ingrese el nombre del producto {i + 1}: ");
                producto[i].nombre = Console.ReadLine();
                Console.Write($"Ingrese el precio del producto {i + 1}: ");
                producto[i].precio = double.Parse(Console.ReadLine());
            }
            double mayor = int.MinValue;
            double menor = int.MaxValue;
            double avg = 0;
            int a = 0;
            int b = 0;
            Console.WriteLine("========================Lista de Productos========================");
            for (int i=0; i<10; i++)
            {
                Console.WriteLine($"Codigo: {producto[i].codigo}, Nombre: {producto[i].nombre}, Precio: ${producto[i].precio}");
                avg += producto[i].precio;
            }
            for(int i=0; i < 10; i++)
            {
                if (producto[i].precio > mayor)
                {
                    mayor = producto[i].precio;
                    a = i;
                }

                if (producto[i].precio < menor)
                {
                    menor = producto[i].precio;
                    b = i;
                }
            }
                avg = avg / 10;
            



            Console.WriteLine($"El producto mas caro es el {producto[a].nombre} con un precio de ${mayor}.");
            Console.WriteLine($"El producto mas barato es el {producto[b].nombre} con un precio de ${menor}.");
            Console.WriteLine($"El promedio de valor de los productos es de ${avg}.");


        }
    }
}
